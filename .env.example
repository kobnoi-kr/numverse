# PostgreSQL connection (required to enable Auth)
# Option A — embedded local DB (Windows: needs non-admin OS user because Admin cannot run Postgres):
EMBEDDED_PG=1
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_USER=postgres
EMBEDDED_PG_PASSWORD=numverse
EMBEDDED_PG_DATABASE=numverse
EMBEDDED_PG_DIR=C:\Users\Public\numverse-pg
EMBEDDED_PG_BIN=C:\Users\Public\numverse-native\bin
EMBEDDED_PG_OS_USER=numversepg
EMBEDDED_PG_OS_PASSWORD="change-me"
DATABASE_URL="postgresql://postgres:numverse@127.0.0.1:54329/numverse?schema=public"

# Option B — external Postgres (Render / Neon / self-hosted): set EMBEDDED_PG=0
# EMBEDDED_PG=0
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/numverse?schema=public"

# Public game bind
HOST=0.0.0.0
PORT=8787
APP_BASE_URL="https://numverse.click"
ENFORCE_HOST=1
ALLOWED_HOSTS=numverse.click,www.numverse.click
AUTH_SUCCESS_REDIRECT=/app.html

# Admin dashboard (localhost-only — tunnel with SSH to access remotely)
ADMIN_PORT=9100
ADMIN_HOST=127.0.0.1
ADMIN_PUBLIC_WS_HOST=127.0.0.1:8787
DASHBOARD_ADMIN_ONLY=0

# OAuth emails that auto-receive roles after Google/Discord login/link
# SUPER_ADMIN_EMAILS=you@gmail.com
# ADMIN_EMAILS=mod@gmail.com
# SUPER_ADMIN_GOOGLE_IDS=
# SUPER_ADMIN_DISCORD_IDS=

# Required in production for signing OAuth state cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Set to 0 to force-disable auth even if DATABASE_URL is set
# AUTH_ENABLED=1

# Session cookie
SESSION_COOKIE_NAME=numverse_session
# COOKIE_SECURE=1
# COOKIE_DOMAIN=

# Session TTL (seconds)
# SESSION_TTL_GUEST_SEC=86400
# SESSION_TTL_REGISTERED_SEC=2592000
# SESSION_TTL_ADMIN_SEC=28800

# Providers
# AUTH_GUEST_ENABLED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your.domain/api/v1/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://your.domain/api/v1/auth/discord/callback

# AUTH_SUCCESS_REDIRECT=/

# Local auto-backup (database + public/uploads + .env). Stays on this machine.
# BACKUP_ENABLED=1
# BACKUP_DIR=C:\Users\Public\numverse-backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
