generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  guest
  registered
}

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum AuthProvider {
  google
  discord
  email
}

enum FriendshipStatus {
  pending
  accepted
  declined
}

enum Gender {
  male
  female
  lgbtq
}

enum CosmeticKind {
  title
  frame
  effect
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  username         String       @db.VarChar(64)
  displayName      String       @map("display_name") @db.VarChar(64)
  avatarUrl        String?      @map("avatar_url") @db.Text
  friendCode       String?      @unique @map("friend_code") @db.VarChar(16)
  gender           Gender?
  age              Int?
  level            Int          @default(1)
  /// Highest level ever reached — level titles stay locked to this even if exp is reset.
  maxLevel         Int          @default(1) @map("max_level")
  exp              Int          @default(0)
  shopPts          Int          @default(0) @map("shop_pts")
  equippedTitleId       String? @map("equipped_title_id") @db.VarChar(64)
  equippedFrameId       String? @map("equipped_frame_id") @db.VarChar(64)
  equippedEffectId      String? @map("equipped_effect_id") @db.VarChar(64)
  /// Non-level decorative titles currently worn (max 4). Level title uses equippedTitleId.
  equippedExtraTitleIds Json    @default("[]") @map("equipped_extra_title_ids")
  accountType      AccountType  @default(guest) @map("account_type")
  status           UserStatus   @default(active)
  emailVerifiedAt  DateTime?    @map("email_verified_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  lastLoginAt      DateTime?    @map("last_login_at")

  authAccounts       AuthAccount[]
  sessions           Session[]
  userRoles          UserRole[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  settings           UserSettings?
  accountEvents      AccountEvent[]
  adminLogs          AdminLog[]          @relation("AdminActor")
  friendshipsSent     Friendship[]       @relation("FriendshipRequester")
  friendshipsReceived Friendship[]       @relation("FriendshipAddressee")
  blocksCreated       UserBlock[]        @relation("Blocker")
  blocksReceived      UserBlock[]        @relation("Blocked")
  gamePlayers         GamePlayer[]
  playerStatistics    PlayerStatistics?
  notifications       Notification[]
  activityLogs        UserActivityLog[]
  contactMessages     ContactMessage[]
  dmSent              DirectMessage[]    @relation("DmSender")
  dmReceived          DirectMessage[]    @relation("DmRecipient")
  cosmetics           UserCosmetic[]
  inventoryItems      UserInventoryItem[]
  shopPtsLedger       ShopPtsLedger[]
  equippedTitle       Cosmetic?          @relation("EquippedTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)
  equippedFrame       Cosmetic?          @relation("EquippedFrame", fields: [equippedFrameId], references: [id], onDelete: SetNull)
  equippedEffect      Cosmetic?          @relation("EquippedEffect", fields: [equippedEffectId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Cosmetic {
  id          String       @id @db.VarChar(64)
  kind        CosmeticKind
  name        String       @db.VarChar(64)
  description String?      @db.VarChar(255)
  shopPrice   Int?         @map("shop_price")
  cssClass    String?      @map("css_class") @db.VarChar(64)
  meta        Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  owners           UserCosmetic[]
  equippedAsTitle  User[]         @relation("EquippedTitle")
  equippedAsFrame  User[]         @relation("EquippedFrame")
  equippedAsEffect User[]         @relation("EquippedEffect")

  @@index([kind])
  @@map("cosmetics")
}

model UserCosmetic {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  cosmeticId String    @map("cosmetic_id") @db.VarChar(64)
  source     String    @db.VarChar(32)
  acquiredAt DateTime  @default(now()) @map("acquired_at")
  /// Ranking titles expire at period end; null = permanent.
  expiresAt  DateTime? @map("expires_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([cosmeticId])
  @@index([expiresAt])
  @@map("user_cosmetics")
}

/// Consumable helper items (e.g. angel card) sold in Shop.
model InventoryItem {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  shopPrice   Int?     @map("shop_price")
  imageUrl    String?  @map("image_url") @db.VarChar(255)
  effect      String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")

  owners UserInventoryItem[]

  @@map("inventory_items")
}

model UserInventoryItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.VarChar(64)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId])
  @@map("user_inventory_items")
}

/// Shop pts earn / spend history (wins, purchases, admin grants).
model ShopPtsLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  delta     Int
  balance   Int
  kind      String   @db.VarChar(32)
  title     String   @db.VarChar(120)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("shop_pts_ledger")
}

model RankingRewardGrant {
  id         String   @id @default(uuid()) @db.Uuid
  period     String   @db.VarChar(16)
  label      String   @db.VarChar(32)
  rank       Int
  userId     String   @map("user_id") @db.Uuid
  cosmeticId String   @map("cosmetic_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([period, label, rank])
  @@index([userId])
  @@map("ranking_reward_grants")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model DirectMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  body        String    @db.VarChar(280)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([createdAt])
  @@map("direct_messages")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model AuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?      @map("provider_email") @db.VarChar(320)
  passwordHash   String?      @map("password_hash") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String? @db.Text

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([tokenHash])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([tokenHash])
  @@map("password_resets")
}

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String   @db.VarChar(128)
  targetId  String?  @map("target_id") @db.VarChar(128)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_logs")
}

model UserSettings {
  userId      String   @id @map("user_id") @db.Uuid
  language    String   @default("th") @db.VarChar(16)
  theme       String   @default("system") @db.VarChar(16)
  preferences Json?
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AccountEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@map("account_events")
}

model Game {
  id          String    @id @default(uuid()) @db.Uuid
  roomCode    String    @map("room_code") @db.VarChar(16)
  roomName    String    @map("room_name") @db.VarChar(64)
  gameMode    String    @map("game_mode") @db.VarChar(32)
  visibility  String    @default("public") @db.VarChar(16)
  status      String    @default("finished") @db.VarChar(32)
  playerCount Int       @map("player_count")
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int       @default(0) @map("duration_sec")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  players GamePlayer[]
  rounds  GameRound[]

  @@index([endedAt])
  @@index([gameMode])
  @@map("games")
}

model GamePlayer {
  id          String  @id @default(uuid()) @db.Uuid
  gameId      String  @map("game_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  displayName String  @map("display_name") @db.VarChar(64)
  rank        Int
  points      Int     @default(0)
  won         Boolean @default(false)

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gameId])
  @@map("game_players")
}

model GameRound {
  id       String @id @default(uuid()) @db.Uuid
  gameId   String @map("game_id") @db.Uuid
  roundNo  Int    @map("round_no")
  summary  Json?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_rounds")
}

model PlayerStatistics {
  userId           String   @id @map("user_id") @db.Uuid
  totalGames       Int      @default(0) @map("total_games")
  gamesWon         Int      @default(0) @map("games_won")
  gamesLost        Int      @default(0) @map("games_lost")
  totalPoints      Int      @default(0) @map("total_points")
  playTimeSec      Int      @default(0) @map("play_time_sec")
  bestWinStreak    Int      @default(0) @map("best_win_streak")
  currentWinStreak Int      @default(0) @map("current_win_streak")
  rankSum          Int      @default(0) @map("rank_sum")
  favoriteMode     String?  @map("favorite_mode") @db.VarChar(32)
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
  @@map("player_statistics")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(160)
  body      String?   @db.Text
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(160)
  body        String    @db.Text
  /// info=green general | warning=yellow | danger=red personal | alert=yellow-red personal
  kind        String    @default("info") @db.VarChar(32)
  /// Targets for personal kinds: user id / username / friend code
  targetIds   Json?     @map("target_ids")
  active      Boolean   @default(false)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  /// Set once when toast + inbox fan-out runs (immediate or when schedule fires)
  publishedAt DateTime? @map("published_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([active, startsAt, endsAt])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([kind])
  @@map("announcements")
}

model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Sparse user action log (login, room create/join, ban, match end).
model UserActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("user_activity_logs")
}

/// Messages from users via "ติดต่อแอดมิน" → Admin Inbox.
model ContactMessage {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  subject     String    @default("") @db.VarChar(128)
  message     String    @db.Text
  imageData   String?   @map("image_data") @db.Text
  status      String    @default("open") @db.VarChar(16)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")
  adminReply  String?   @map("admin_reply") @db.Text
  repliedAt   DateTime? @map("replied_at")
  repliedById String?   @map("replied_by") @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("contact_messages")
}
